# Choose groq, openai, anthropic, or openai_compatible.
LLM_PROVIDER=groq

# Fill only the key for your selected provider.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model override; blank uses the provider default.
LLM_MODEL=

# Custom OpenAI-compatible generation endpoint only.
LLM_BASE_URL=
LLM_API_KEY=

# Blank uses LLM_PROVIDER. Custom endpoints require a native search provider.
SEARCH_PROVIDER=
SEARCH_MODEL=

DATABASE_PATH=data/outreach.db
CHECKPOINT_PATH=runs/checkpoints.sqlite3
