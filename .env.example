# Choose groq, openai, anthropic, openrouter, or openai_compatible.
LLM_PROVIDER=groq

# Fill only the key for your selected provider.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional model override; blank uses the provider default.
LLM_MODEL=

# Custom OpenAI-compatible generation endpoint only.
LLM_BASE_URL=
LLM_API_KEY=

# Blank uses LLM_PROVIDER. OpenRouter supports discovery with the same key.
# Custom endpoints require groq, openai, anthropic, or openrouter for search.
SEARCH_PROVIDER=
SEARCH_MODEL=

DATABASE_PATH=data/outreach.db
CHECKPOINT_PATH=runs/checkpoints.sqlite3

# Optional: Email sending setup in the UI can fill these settings for you.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
