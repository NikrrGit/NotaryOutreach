# Use none for editable email templates without a model API key.
# Optional AI checks/drafts: grok, groq, openai, anthropic, openrouter, openai_compatible.
LLM_PROVIDER=none

# Tavily supplies live discovery. It is a search service, not a model provider.
TAVILY_API_KEY=

# Fill only the key for your selected provider.
# Grok (xAI); XAI_API_KEY is also accepted.
GROK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional model override; blank uses the provider default.
LLM_MODEL=

# Custom OpenAI-compatible generation endpoint only.
LLM_BASE_URL=
LLM_API_KEY=

# Choose tavily or a supported native model provider for discovery.
# Blank uses LLM_PROVIDER (or tavily when LLM_PROVIDER=none).
SEARCH_PROVIDER=tavily
# Used only by model search providers; Tavily ignores this setting.
SEARCH_MODEL=

DATABASE_PATH=data/outreach.db
CHECKPOINT_PATH=runs/checkpoints.sqlite3

# Optional: Email sending setup in the UI can fill these settings for you.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
